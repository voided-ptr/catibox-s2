{
  general: {
    // YouTube OAuth Refresh Token
    // Accepts text. Default: "".
    oauthRefreshToken: "",
    // YouTube PO Token
    // Accepts text. Default: "".
    poToken: "",
    // YouTube Visitor Data
    // Accepts text. Default: "".
    visitorData: "",
    // Allow YouTube Search
    // Accepts true or false. Default: true.
    allowYoutubeSearch: true,
    // Which YouTube clients to try, in order, by youtube-source class name.
    // YouTube periodically breaks one client or another, and a different order is the
    // usual fix. An unknown name is skipped with a warning.
    // The Tv client is appended automatically when an OAuth token is configured.
    // Accepts a list of text. Default: ["IosWithThumbnail", "AndroidWithThumbnail", "AndroidVrWithThumbnail", "MusicWithThumbnail", "WebWithThumbnail"].
    youtubeClients: [
      "IosWithThumbnail",
      "AndroidWithThumbnail",
      "AndroidVrWithThumbnail",
      "MusicWithThumbnail",
      "WebWithThumbnail"
    ]
  },
  // Which audio sources players are allowed to load from.
  sources: {
    // Allow YouTube links
    // Accepts true or false. Default: true.
    enableYoutube: true,
    // Allow SoundCloud links
    // Accepts true or false. Default: true.
    enableSoundCloud: true,
    // Allow Bandcamp links
    // Accepts true or false. Default: true.
    enableBandcamp: true,
    // Allow Vimeo links
    // Accepts true or false. Default: true.
    enableVimeo: true,
    // Allow Twitch stream links
    // Accepts true or false. Default: true.
    enableTwitch: true,
    // Allow arbitrary direct HTTP(S) media URLs.
    // OFF by default, and the only source that is. Every other source resolves through a
    // known platform's API; this one makes the SERVER fetch whatever URL a player types,
    // which can be used to probe hosts only the server can reach (other containers, the
    // local network, cloud metadata endpoints). Enable only on a trusted player base, and
    // preferably alongside urlAllowPatterns.
    // Accepts true or false. Default: false.
    enableHttp: false,
    // Permit direct HTTP URLs that resolve to loopback, private, or link-local addresses,
    // for operators only: other players are always refused, including through redirects
    // and playlists. Only consulted when enableHttp is true. Leave false unless you are
    // deliberately streaming from another machine on the same LAN.
    // Accepts true or false. Default: false.
    allowPrivateNetworkHosts: false,
    // Allow media:<name> to play a file from the soundstage-media folder in the server's
    // directory (in singleplayer, the game directory). A player names a file directly in
    // that folder and nothing else: no paths, no subfolders, no hidden files.
    // Accepts true or false. Default: true.
    enableMediaFolder: true
  },
  // How the server makes video for screens. FFmpeg's libraries, when the server needs them, are
  // set on the Video and audio decoders page.
  video: {
    // Whether screens show video. On by default. Off, a display shows what is playing
    // instead of a picture; the sound is the same either way.
    // Accepts true or false. Default: true.
    enableVideo: true,
    // Largest picture sent to screens, as the height of a 16:9 picture; a wider or
    // narrower one may have as many pixels. Every client decodes it on its own processor,
    // so larger costs every viewer more.
    // Accepts a whole number from 144 to 1080. Default: 1080.
    maxVideoHeight: 1080,
    // Most receivers showing video at once. 0, the default, lets the server start another
    // whenever it has room. A receiver waiting its turn plays the sound, and its displays
    // show what is playing until its picture can start.
    // Accepts a whole number from 0 to 1024. Default: 0.
    maxPicturesEncoding: 0,
    // The most a picture may send each player, in kilobits a second. 0, the default, sets
    // none. A source with several versions (a YouTube format, a Twitch quality, a library's
    // own smaller stream) sends a smaller one; a file with one version is converted to fit.
    // The server's processor converts pictures of 1080 lines or fewer only; a larger one
    // needs its graphics card, or plays with sound only and the displays say why.
    // Accepts a whole number from 0 to 100000. Default: 0.
    maxPlayerKbps: 0,
    // The most every picture together may send from this server, in kilobits a second, for
    // every receiver and every player. 0, the default, sets none. Set it below your upload
    // speed, leaving room for the game itself: sound is never counted or held back. Pictures
    // that would go over are sent in a smaller version or converted to fit, as maxPlayerKbps
    // does; where neither can be done, the displays say the server can't keep up.
    // Accepts a whole number from 0 to 10000000. Default: 0.
    maxUploadKbps: 0,
    // Encoders on the processor this server does not make copies with, by name, such as libavcodec,
    // openh264 or ffmpeg-pack. The others are used for pictures of 1080 lines or fewer when no
    // graphics card encoder fits; the codec pack's only once an operator agreed to its licence.
    // Accepts a list of text. Default: [].
    softwareEncodersOff: [
    ]
  },
  // Regex filters applied to the links players ask to play, before they are resolved.
  // If allow is non-empty a URL must match at least one entry to be accepted, and deny
  // is not consulted. If allow is empty, any URL is accepted unless it matches deny.
  // Patterns are matched against the whole URL, case-insensitively. An address an operator
  // types in game for an add-on, such as a media library's, is not filtered.
  filters: {
    // Example: ["^https://(www\\.)?youtube\\.com/.*"]
    // Accepts a list of text. Default: [].
    urlAllowPatterns: [
    ],
    // Example: [".*\\.exe$"]
    // Accepts a list of text. Default: [].
    urlDenyPatterns: [
    ]
  },
  // Bounds on queues, and on how many receivers may play at once.
  limits: {
    // Most tracks one playlist link may enqueue. A watch URL carrying '&list=' or a search
    // result queues only the track the player actually selected, so this applies to genuine
    // playlist links.
    // Accepts a whole number from 1 to 1000. Default: 25.
    maxPlaylistTracks: 25,
    // Most tracks a single receiver may hold queued at once.
    // Accepts a whole number from 1 to 10000. Default: 100.
    maxQueueSize: 100,
    // Most receivers and party boxes that may play at once on this server; 0 means no limit.
    // Each one playing decodes, encodes and streams audio to everyone nearby, and fetches from
    // its source. A player asked to start one beyond this is told to stop another first.
    // Accepts a whole number from 0 to 1024. Default: 16.
    maxPlayingReceivers: 16
  },
  // Votes on a featured station's screens. Left empty, each player's own game sends their
  // votes to the station under the name they chose, and this server sends nothing.
  stations: {
    // A Hive365 API key, given by Hive365 to servers that name their players with the server's
    // name. With it and serverName set, this server sends its players' votes itself, each under
    // the player's account name and the server's name. Kept on this server only.
    // Accepts text. Default: "".
    hive365Key: "",
    // The name this server's players' votes carry, such as "Example SMP": letters, digits,
    // spaces and punctuation, at most 32 characters. Used only with hive365Key.
    // Accepts text. Default: "".
    serverName: ""
  },
  backends: {
    order: [
      "system",
      "provided",
      "fast"
    ],
    system: {
      enabled: true,
      gpu: true
    },
    provided: {
      enabled: true,
      gpu: true,
      path: ""
    },
    fast: {
      enabled: true,
      gpu: true
    }
  }
}
